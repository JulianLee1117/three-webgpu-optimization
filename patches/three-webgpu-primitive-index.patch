diff --git a/test/unit/src/renderers/webgpu/WebGPUPrimitiveIndex.tests.js b/test/unit/src/renderers/webgpu/WebGPUPrimitiveIndex.tests.js
new file mode 100644
index 0000000000000000000000000000000000000000..b73851aca0f98912ae860c24777d580aca944c03
--- /dev/null
+++ b/test/unit/src/renderers/webgpu/WebGPUPrimitiveIndex.tests.js
@@ -0,0 +1,212 @@
+import * as THREE from '../../../../../src/Three.WebGPU.js';
+import GLSLNodeBuilder from '../../../../../src/renderers/webgl-fallback/nodes/GLSLNodeBuilder.js';
+import WebGPUBackend from '../../../../../src/renderers/webgpu/WebGPUBackend.js';
+import { GPUFeatureName } from '../../../../../src/renderers/webgpu/utils/WebGPUConstants.js';
+
+const { TSL } = THREE;
+
+function countOccurrences( source, token ) {
+
+	return source.split( token ).length - 1;
+
+}
+
+function createRenderer( primitiveIndexSupported ) {
+
+	return {
+		backend: {
+			capabilities: { getUniformBufferLimit: () => 65536 },
+			isWebGPUBackend: true,
+			utils: { getTextureSampleData: () => ( { primarySamples: 1 } ) }
+		},
+		contextNode: TSL.context( {} ),
+		library: new THREE.StandardNodeLibrary(),
+		getRenderTarget: () => null,
+		getMRT: () => null,
+		coordinateSystem: THREE.WebGPUCoordinateSystem,
+		outputColorSpace: THREE.SRGBColorSpace,
+		debug: { diagnostics: { keywords: false } },
+		currentSamples: 1,
+		depth: false,
+		logarithmicDepthBuffer: false,
+		reversedDepthBuffer: false,
+		lighting: { enabled: false },
+		shadowMap: { enabled: false },
+		highPrecision: true,
+		hasFeature: ( name ) => name === GPUFeatureName.PrimitiveIndex && primitiveIndexSupported,
+		hasCompatibility: () => false
+	};
+
+}
+
+function buildShaders( fragmentNode, primitiveIndexSupported ) {
+
+	const material = new THREE.NodeMaterial();
+	material.vertexNode = TSL.vec4( TSL.positionLocal, 1 );
+	material.fragmentNode = fragmentNode;
+
+	const geometry = new THREE.BufferGeometry();
+	geometry.setAttribute( 'position', new THREE.Float32BufferAttribute( [
+		0, 0, 0,
+		1, 0, 0,
+		0, 1, 0
+	], 3 ) );
+
+	const builder = new THREE.WGSLNodeBuilder(
+		new THREE.Mesh( geometry, material ),
+		createRenderer( primitiveIndexSupported )
+	);
+	builder.camera = new THREE.PerspectiveCamera();
+	builder.scene = new THREE.Scene();
+	builder.build();
+
+	return builder;
+
+}
+
+export default QUnit.module( 'Renderers', () => {
+
+	QUnit.module( 'WebGPU', () => {
+
+		QUnit.module( 'primitiveIndex', () => {
+
+			QUnit.test( 'TSL export and device feature name', ( assert ) => {
+
+				assert.strictEqual( GPUFeatureName.PrimitiveIndex, 'primitive-index' );
+				assert.ok( Object.values( GPUFeatureName ).includes( 'primitive-index' ), 'backend feature negotiation includes primitive-index' );
+				assert.ok( TSL.primitiveIndex.isIndexNode, 'exports an IndexNode' );
+				assert.strictEqual( TSL.primitiveIndex.scope, THREE.IndexNode.PRIMITIVE );
+				assert.strictEqual( THREE.IndexNode.PRIMITIVE, 'primitive' );
+
+			} );
+
+			QUnit.test( 'device negotiation', async ( assert ) => {
+
+				const originalGPU = Object.getOwnPropertyDescriptor( navigator, 'gpu' );
+				let adapterOptions;
+				let deviceDescriptor;
+				const device = {
+					features: new Set( [ GPUFeatureName.PrimitiveIndex ] ),
+					lost: new Promise( () => {} )
+				};
+				const adapter = {
+					features: new Set( [ GPUFeatureName.PrimitiveIndex ] ),
+					requestDevice: async ( descriptor ) => {
+
+						deviceDescriptor = descriptor;
+						return device;
+
+					}
+				};
+
+				Object.defineProperty( navigator, 'gpu', {
+					configurable: true,
+					value: {
+						requestAdapter: async ( options ) => {
+
+							adapterOptions = options;
+							return adapter;
+
+						}
+					}
+				} );
+
+				try {
+
+					const backend = new WebGPUBackend();
+					await backend.init( {
+						xr: { enabled: false },
+						_samples: 4,
+						getCanvasTarget: () => ( {} ),
+						onDeviceLost: () => {},
+						onError: () => {}
+					} );
+
+					assert.strictEqual( adapterOptions.featureLevel, 'compatibility' );
+					assert.deepEqual( deviceDescriptor.requiredFeatures, [ GPUFeatureName.PrimitiveIndex ], 'requests the advertised optional feature' );
+					assert.strictEqual( backend.hasFeature( GPUFeatureName.PrimitiveIndex ), true, 'the created device exposes the enabled feature' );
+
+				} finally {
+
+					if ( originalGPU === undefined ) {
+
+						delete navigator.gpu;
+
+					} else {
+
+						Object.defineProperty( navigator, 'gpu', originalGPU );
+
+					}
+
+				}
+
+			} );
+
+			QUnit.test( 'conditional WGSL generation', ( assert ) => {
+
+				const builder = buildShaders(
+					TSL.vec4( TSL.float( TSL.primitiveIndex ), 0, 0, 1 ),
+					true
+				);
+
+				assert.strictEqual( countOccurrences( builder.fragmentShader, 'enable primitive_index;' ), 1, 'emits one feature directive' );
+				assert.strictEqual(
+					countOccurrences( builder.fragmentShader, '@builtin( primitive_index ) primitiveIndex : u32' ),
+					1,
+					'emits one fragment builtin'
+				);
+				assert.ok( builder.fragmentShader.includes( 'f32( primitiveIndex )' ), 'uses the builtin directly in fragment code' );
+				assert.notOk( builder.vertexShader.includes( 'primitive_index' ), 'does not emit the feature in the vertex shader' );
+				assert.notOk( builder.fragmentShader.includes( '@interpolate' ), 'does not synthesize a vertex varying' );
+
+				const unused = buildShaders( TSL.vec4( 1, 0, 0, 1 ), false );
+				assert.notOk( unused.vertexShader.includes( 'primitive_index' ), 'ordinary vertex shader remains feature-free' );
+				assert.notOk( unused.fragmentShader.includes( 'primitive_index' ), 'ordinary fragment shader remains feature-free' );
+
+			} );
+
+			QUnit.test( 'feature and stage validation', ( assert ) => {
+
+				const unsupported = new THREE.WGSLNodeBuilder(
+					{ material: {}, geometry: {} },
+					{ hasFeature: () => false }
+				);
+				unsupported.shaderStage = 'fragment';
+				assert.throws(
+					() => unsupported.getPrimitiveIndex(),
+					/requires the WebGPU "primitive-index" feature/,
+					'rejects a device without the optional feature'
+				);
+
+				for ( const shaderStage of [ 'vertex', 'compute' ] ) {
+
+					const wrongStage = new THREE.WGSLNodeBuilder(
+						{ material: {}, geometry: {} },
+						{ hasFeature: () => true }
+					);
+					wrongStage.shaderStage = shaderStage;
+					assert.throws(
+						() => wrongStage.getPrimitiveIndex(),
+						/only available in fragment shaders/,
+						`rejects ${ shaderStage } use`
+					);
+
+				}
+
+				const webgl = new GLSLNodeBuilder(
+					{ material: {}, geometry: {} },
+					{ backend: {} }
+				);
+				assert.throws(
+					() => webgl.getPrimitiveIndex(),
+					/not supported by the WebGL backend/,
+					'rejects the WebGL fallback explicitly'
+				);
+
+			} );
+
+		} );
+
+	} );
+
+} );
