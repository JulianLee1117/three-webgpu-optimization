+import { EventDispatcher } from '../../core/EventDispatcher.js';
+
+let _id = 0;
+
+const _typeItemSizes = new Map( [
+	[ 'float', 1 ],
+	[ 'vec2', 2 ],
+	[ 'vec4', 4 ],
+	[ 'int', 1 ],
+	[ 'ivec2', 2 ],
+	[ 'ivec4', 4 ],
+	[ 'uint', 1 ],
+	[ 'uvec2', 2 ],
+	[ 'uvec4', 4 ]
+] );
+
+/**
+ * A storage buffer attribute backed by an externally-created {@link GPUBuffer}.
+ *
+ * This class represents a borrowed GPU resource. `WebGPURenderer` does not
+ * create, upload, or destroy its buffer. The application must keep the buffer
+ * and its originating device alive while the attribute is in use.
+ *
+ * The supported element types are 32-bit float, signed integer, and unsigned
+ * integer scalars, vec2s, and vec4s. A packed `vec3` array has a 12-byte CPU
+ * stride but WGSL storage arrays require a 16-byte stride, so `vec3` types are
+ * deliberately rejected. Packed three-component data can instead be exposed
+ * as a scalar attribute with `count` set to three times the logical item count.
+ *
+ * The attribute is storage-binding only. It cannot be used as a vertex, index,
+ * indirect, structured, atomic, or PBO buffer. The declared device must be the
+ * same device used by the renderer. The buffer must be unmapped and include
+ * `GPUBufferUsage.STORAGE`. `byteOffset` must obey the device's
+ * `minStorageBufferOffsetAlignment`, and the exact logical range must fit the
+ * buffer and `maxStorageBufferBindingSize`.
+ *
+ * ```js
+ * const attribute = new ExternalStorageBufferAttribute( buffer, {
+ * 	device,
+ * 	type: 'vec2',
+ * 	count: 3
+ * } );
+ * const positions = storage( attribute ).toReadOnly();
+ * ```
+ *
+ * Dispose every material or compute node that consumes this attribute before
+ * disposing the attribute. `dispose()` releases Three.js bookkeeping but never
+ * destroys the external buffer. Before the owner destroys or recycles the
+ * buffer, wait for submitted GPU work with `device.queue.onSubmittedWorkDone()`.
+ * A disposed attribute can be adopted again by a fresh consumer while its
+ * external buffer remains valid.
+ *
+ * Note: This type of buffer attribute can only be used with `WebGPURenderer`'s
+ * WebGPU backend.
+ *
+ * @augments EventDispatcher
+ */
+class ExternalStorageBufferAttribute extends EventDispatcher {
+
+	/**
+	 * Constructs a new external storage buffer attribute.
+	 *
+	 * @param {GPUBuffer} buffer - The externally-owned GPU buffer.
+	 * @param {Object} options - The typed range and originating device.
+	 * @param {GPUDevice} options.device - The GPU device that created the buffer.
+	 * @param {('float'|'vec2'|'vec4'|'int'|'ivec2'|'ivec4'|'uint'|'uvec2'|'uvec4')} options.type - The TSL element type.
+	 * @param {number} options.count - The element count.
+	 * @param {number} [options.byteOffset=0] - The byte offset of the first element.
+	 */
+	constructor( buffer, options ) {
+
+		super();
+
+		if ( buffer === null || typeof buffer !== 'object' ) {
+
+			throw new TypeError( 'THREE.ExternalStorageBufferAttribute: buffer must be a GPUBuffer.' );
+
+		}
+
+		if ( options === null || typeof options !== 'object' || Array.isArray( options ) ) {
+
+			throw new TypeError( 'THREE.ExternalStorageBufferAttribute: options must be an object.' );
+
+		}
+
+		const { device, type, count, byteOffset = 0 } = options;
+
+		if ( device === null || typeof device !== 'object' ) {
+
+			throw new TypeError( 'THREE.ExternalStorageBufferAttribute: options.device must be the GPUDevice that created the buffer.' );
+
+		}
+
+		const itemSize = _typeItemSizes.get( type );
+
+		if ( itemSize === undefined ) {
+
+			throw new TypeError( 'THREE.ExternalStorageBufferAttribute: options.type must be float, vec2, vec4, int, ivec2, ivec4, uint, uvec2, or uvec4.' );
+
+		}
+
+		if ( Number.isSafeInteger( count ) === false || count <= 0 ) {
+
+			throw new TypeError( 'THREE.ExternalStorageBufferAttribute: options.count must be a positive safe integer.' );
+
+		}
+
+		if ( Number.isSafeInteger( byteOffset ) === false || byteOffset < 0 ) {
+
