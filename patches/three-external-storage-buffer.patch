+				const attribute = new ExternalStorageBufferAttribute( createExternalBuffer(), { device, type, count: 3 } );
+				const node = storage( attribute );
+
+				assert.strictEqual( attribute.itemSize, itemSize, `${ type } has the expected item size` );
+				assert.strictEqual( attribute.byteLength, 3 * itemSize * 4, `${ type } has the expected byte length` );
+				assert.strictEqual( node.bufferType, type, `${ type } is inferred by storage(attribute)` );
+				assert.strictEqual( node.bufferCount, 3, `${ type } retains the declared count` );
+				assert.strictEqual( new StorageBufferNode( attribute, type, 3 ).bufferType, type, `${ type } accepts matching explicit metadata` );
+
+			}
+
+		} );
+
+		QUnit.test( 'exports from both WebGPU entry points', ( assert ) => {
+
+			assert.strictEqual( WebGPUExport, ExternalStorageBufferAttribute, 'exports from Three.WebGPU.js' );
+			assert.strictEqual( WebGPUNodesExport, ExternalStorageBufferAttribute, 'exports from Three.WebGPU.Nodes.js' );
+
+		} );
+
+		QUnit.test( 'adopts the exact buffer range without allocation, upload, or destruction', ( assert ) => {
+
+			const { backend, calls, device, utils } = createHarness();
+			const buffer = createExternalBuffer();
+			const attribute = new ExternalStorageBufferAttribute( buffer, { device, type: 'vec2', count: 3, byteOffset: 256 } );
+
+			utils.createAttribute( attribute, STORAGE_ATTRIBUTE_USAGE );
+
+			const data = backend.get( attribute );
+
+			assert.strictEqual( data.buffer, buffer, 'adopts the exact GPUBuffer object' );
+			assert.strictEqual( data.bindingOffset, 256, 'stores the binding offset' );
+			assert.strictEqual( data.bindingSize, 24, 'stores the exact binding size' );
+			assert.strictEqual( data.ownsBuffer, false, 'records borrowed ownership' );
+			assert.strictEqual( calls.createBuffer, 0, 'does not allocate a replacement GPUBuffer' );
+			assert.strictEqual( calls.writeBuffer, 0, 'does not upload CPU data' );
+
+			utils.updateAttribute( attribute );
+
+			assert.strictEqual( calls.writeBuffer, 0, 'does not update the borrowed buffer' );
+
+			utils.destroyAttribute( attribute );
+
