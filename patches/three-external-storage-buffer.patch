+			assert.strictEqual( calls.bindGroupResource.offset, 256, 'binds the requested byte offset' );
+			assert.strictEqual( calls.bindGroupResource.size, 24, 'binds only the logical byte range' );
+
+		} );
+
+		QUnit.test( 'does not silently reuse a replaced or incompatible cached buffer', ( assert ) => {
