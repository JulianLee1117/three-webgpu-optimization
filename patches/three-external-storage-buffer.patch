@@ -0,0 +1,595 @@
+import ExternalStorageBufferAttribute from '../../../../../src/renderers/common/ExternalStorageBufferAttribute.js';
+import { BufferAttribute } from '../../../../../src/core/BufferAttribute.js';
+import Attributes from '../../../../../src/renderers/common/Attributes.js';
+import Bindings from '../../../../../src/renderers/common/Bindings.js';
+import WebGPUAttributeUtils from '../../../../../src/renderers/webgpu/utils/WebGPUAttributeUtils.js';
+import WebGPUBindingUtils from '../../../../../src/renderers/webgpu/utils/WebGPUBindingUtils.js';
+import WebGLAttributeUtils from '../../../../../src/renderers/webgl-fallback/utils/WebGLAttributeUtils.js';
+import BufferAttributeNode from '../../../../../src/nodes/accessors/BufferAttributeNode.js';
+import StorageBufferNode, { storage } from '../../../../../src/nodes/accessors/StorageBufferNode.js';
+import { ExternalStorageBufferAttribute as WebGPUExport } from '../../../../../src/Three.WebGPU.js';
+import { ExternalStorageBufferAttribute as WebGPUNodesExport } from '../../../../../src/Three.WebGPU.Nodes.js';
+
+const COPY_SRC = 0x0004;
+const COPY_DST = 0x0008;
+const INDEX = 0x0010;
+const VERTEX = 0x0020;
+const STORAGE = 0x0080;
+const INDIRECT = 0x0100;
+const STORAGE_ATTRIBUTE_USAGE = STORAGE | VERTEX | COPY_SRC | COPY_DST;
+
+class MockBackend {
+
+	constructor( device ) {
+
+		this.device = device;
+		this.data = new WeakMap();
+		this.attributeUtils = null;
+		this.createBindingsCount = 0;
+		this.deleteBindGroupDataCount = 0;
+		this.updateBindingsCalls = [];
+
+	}
+
+	get( object ) {
+
+		let data = this.data.get( object );
+
+		if ( data === undefined ) {
+
+			data = {};
+			this.data.set( object, data );
+
+		}
+
+		return data;
+
+	}
+
+	has( object ) {
+
+		return this.data.has( object );
+
+	}
+
+	delete( object ) {
+
+		this.data.delete( object );
+
+	}
+
+	createStorageAttribute( attribute ) {
+
+		if ( attribute.isExternalStorageBufferAttribute === true ) {
+
+			this.attributeUtils.createAttribute( attribute, STORAGE_ATTRIBUTE_USAGE );
+
+		} else {
+
+			this.get( attribute ).buffer = {};
+
+		}
+
+	}
+
+	destroyAttribute( attribute ) {
+
+		if ( attribute.isExternalStorageBufferAttribute === true ) {
+
+			this.attributeUtils.destroyAttribute( attribute );
+
+		} else {
+
+			this.delete( attribute );
+
+		}
+
+	}
+
+	createBindings() {
+
+		this.createBindingsCount ++;
+
+	}
+
+	updateBindings( bindGroup, bindings, cacheKey, version ) {
+
+		this.updateBindingsCalls.push( { bindGroup, bindings, cacheKey, version } );
+
+	}
+
+	deleteBindGroupData() {
+
+		this.deleteBindGroupDataCount ++;
+
+	}
+
+}
+
+function createDevice( limits = {} ) {
+
+	const calls = {
+		createBuffer: 0,
+		writeBuffer: 0,
+		submit: 0,
+		copy: null,
+		bindGroupResource: null
+	};
+
+	const device = {
+		limits: {
+			minStorageBufferOffsetAlignment: 256,
+			maxStorageBufferBindingSize: 1024,
+			...limits
+		},
+		createBuffer( descriptor ) {
+
+			calls.createBuffer ++;
+			const size = descriptor.size;
+
+			return {
+				async mapAsync() {},
+				getMappedRange() {
+
+					return new ArrayBuffer( size );
+
+				},
+				destroy() {}
+			};
+
+		},
+		createCommandEncoder() {
+
+			return {
+				copyBufferToBuffer( ...args ) {
+
+					calls.copy = args;
+
+				},
+				finish() {
+
+					return {};
+
+				}
+			};
+
+		},
+		createBindGroup( descriptor ) {
+
+			const { buffer, offset, size } = descriptor.entries[ 0 ].resource;
+			calls.bindGroupResource = { buffer, offset, size };
+			return {};
+
+		},
+		queue: {
+			writeBuffer() {
+
+				calls.writeBuffer ++;
+
+			},
+			submit() {
+
+				calls.submit ++;
+
+			}
+		}
+	};
+
+	return { calls, device };
+
+}
+
+function createExternalBuffer( overrides = {} ) {
+
+	return {
+		size: 512,
+		usage: STORAGE | COPY_SRC,
+		mapState: 'unmapped',
+		destroyCount: 0,
+		destroy() {
+
+			this.destroyCount ++;
+
+		},
+		...overrides
+	};
+
+}
+
+function createHarness( limits ) {
+
+	const { calls, device } = createDevice( limits );
+	const backend = new MockBackend( device );
+	const utils = new WebGPUAttributeUtils( backend );
+	backend.attributeUtils = utils;
+
+	return { backend, calls, device, utils };
+
+}
+
+function createManagerHarness( limits ) {
+
+	const harness = createHarness( limits );
+	const info = {
+		createdStorageAttributes: 0,
+		destroyedStorageAttributes: 0,
+		createStorageAttribute() {
+
+			this.createdStorageAttributes ++;
+
+		},
+		destroyAttribute() {
+
+			this.destroyedStorageAttributes ++;
+
+		}
+	};
+	const attributes = new Attributes( harness.backend, info );
+	const nodes = {
+		updateGroup() {
+
+			return true;
+
+		}
+	};
+	const pipelines = {};
+	const bindings = new Bindings( harness.backend, nodes, {}, attributes, pipelines, info );
+
+	return { ...harness, attributes, bindings, info, nodes, pipelines };
+
+}
+
+export default QUnit.module( 'Renderers', () => {
+
+	QUnit.module( 'ExternalStorageBufferAttribute', () => {
+
+		QUnit.test( 'constructor defines an immutable typed range without a CPU array', ( assert ) => {
+
+			const { device } = createDevice();
+			const buffer = createExternalBuffer();
+			const attribute = new ExternalStorageBufferAttribute( buffer, { device, type: 'vec2', count: 3, byteOffset: 256 } );
+
+			assert.strictEqual( attribute.isExternalStorageBufferAttribute, true, 'is an external storage buffer attribute' );
+			assert.strictEqual( attribute.isStorageBufferAttribute, true, 'is a storage buffer attribute' );
+			assert.strictEqual( attribute.isBufferAttribute, undefined, 'is not a CPU BufferAttribute' );
+			assert.strictEqual( attribute.array, undefined, 'does not expose a fake CPU array' );
+			assert.strictEqual( attribute.type, 'vec2', 'retains the declared element type' );
+			assert.strictEqual( attribute.itemSize, 2, 'derives the component count' );
+			assert.strictEqual( attribute.count, 3, 'retains the element count' );
+			assert.strictEqual( attribute.byteOffset, 256, 'retains the byte offset' );
+			assert.strictEqual( attribute.byteLength, 24, 'computes the exact logical byte length' );
+			assert.strictEqual( attribute.id.startsWith( 'external-' ), true, 'uses a namespace distinct from numeric BufferAttribute IDs' );
+			assert.notStrictEqual( String( attribute.id ), String( new BufferAttribute( new Float32Array( 1 ), 1 ).id ), 'cannot collide in string cache keys' );
+			assert.notStrictEqual( attribute.id, new ExternalStorageBufferAttribute( buffer, { device, type: 'float', count: 1 } ).id, 'assigns a unique ID' );
+			assert.throws( () => {
+
+				attribute.buffer = createExternalBuffer();
+
+			}, 'buffer identity is immutable' );
+			assert.throws( () => {
+
+				attribute.device = {};
+
+			}, 'originating device is immutable' );
+			assert.throws( () => {
+
+				attribute.version = 1;
+
+			}, 'version is immutable' );
+			assert.throws( () => {
+
+				attribute.needsUpdate = true;
+
+			}, /cannot be updated from the CPU/ );
+
+			assert.throws( () => new ExternalStorageBufferAttribute( null, { device, type: 'float', count: 1 } ), /buffer must be a GPUBuffer/ );
+			assert.throws( () => new ExternalStorageBufferAttribute( buffer ), /options must be an object/ );
+			assert.throws( () => new ExternalStorageBufferAttribute( buffer, { device: null, type: 'float', count: 1 } ), /options\.device/ );
+			assert.throws( () => new ExternalStorageBufferAttribute( buffer, { device, type: 'vec3', count: 1 } ), /options\.type must be/ );
+			assert.throws( () => new ExternalStorageBufferAttribute( buffer, { device, type: 'float', count: 0 } ), /options\.count must be a positive safe integer/ );
+			assert.throws( () => new ExternalStorageBufferAttribute( buffer, { device, type: 'float', count: 1, byteOffset: - 1 } ), /options\.byteOffset must be a non-negative safe integer/ );
+
+		} );
+
+		QUnit.test( 'supports and infers the nine scalar, vec2, and vec4 element types', ( assert ) => {
+
+			const { device } = createDevice();
+			const cases = [
+				[ 'float', 1 ],
+				[ 'vec2', 2 ],
+				[ 'vec4', 4 ],
+				[ 'int', 1 ],
+				[ 'ivec2', 2 ],
+				[ 'ivec4', 4 ],
+				[ 'uint', 1 ],
+				[ 'uvec2', 2 ],
+				[ 'uvec4', 4 ]
+			];
+
+			for ( const [ type, itemSize ] of cases ) {
