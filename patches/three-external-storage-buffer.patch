+
+		/**
+		 * Marks this object as a storage buffer attribute.
+		 *
+		 * @type {boolean}
+		 * @readonly
+		 * @default true
+		 */
+		this.isStorageBufferAttribute = true;
+
+		/**
+		 * The ID of the buffer attribute.
+		 *
+		 * @type {string}
+		 * @readonly
+		 */
+		Object.defineProperty( this, 'id', { value: `external-${ _id ++ }` } );
+
+		/**
+		 * The name of the buffer attribute.
+		 *
+		 * @type {string}
+		 */
+		this.name = '';
+
+		/**
+		 * The externally-owned GPU buffer.
+		 *
+		 * @type {GPUBuffer}
+		 * @readonly
+		 */
+		this.buffer = buffer;
+
+		/**
+		 * The GPU device that created {@link ExternalStorageBufferAttribute#buffer}.
+		 *
+		 * @type {GPUDevice}
+		 * @readonly
+		 */
+		this.device = device;
+
+		/**
+		 * The TSL element type exposed by the storage binding.
+		 *
+		 * @type {string}
+		 * @readonly
+		 */
+		this.type = type;
+
+		/**
+		 * The number of 32-bit components per element.
+		 *
+		 * @type {number}
+		 * @readonly
+		 */
+		this.itemSize = itemSize;
+
+		/**
+		 * The number of elements represented by this attribute.
+		 *
+		 * @type {number}
+		 * @readonly
+		 */
+		this.count = count;
+
+		/**
+		 * The byte offset of the first element in the buffer.
+		 *
+		 * @type {number}
+		 * @readonly
+		 */
+		this.byteOffset = byteOffset;
+
+		/**
+		 * The exact logical length of the bound range in bytes.
+		 *
+		 * @type {number}
+		 * @readonly
+		 */
+		this.byteLength = byteLength;
+
+		/**
+		 * The version of the buffer attribute.
+		 *
+		 * @type {number}
+		 * @readonly
+		 */
+		this.version = 0;
+
+		Object.defineProperty( this, '_bindingTokens', { value: new Set() } );
+
+		Object.defineProperties( this, {
+			buffer: { writable: false, configurable: false },
+			device: { writable: false, configurable: false },
+			type: { writable: false, configurable: false },
+			itemSize: { writable: false, configurable: false },
+			count: { writable: false, configurable: false },
+			byteOffset: { writable: false, configurable: false },
+			byteLength: { writable: false, configurable: false },
+			version: { writable: false, configurable: false }
+		} );
+
+	}
+
+	/**
+	 * Registers an internal live bind-group reference.
+	 *
+	 * @private
+	 * @param {Object} token - A renderer-local binding token.
+	 */
+	_retainBinding( token ) {
+
+		this._bindingTokens.add( token );
+
+	}
+
+	/**
+	 * Releases an internal live bind-group reference.
+	 *
+	 * @private
+	 * @param {Object} token - A renderer-local binding token.
+	 */
+	_releaseBinding( token ) {
+
+		this._bindingTokens.delete( token );
+
+	}
+
+	/**
+	 * Releases Three.js resources associated with this attribute without
+	 * destroying the externally-owned GPU buffer.
+	 *
+	 * All materials and compute nodes that consume the attribute must be
+	 * disposed first.
+	 *
+	 * @fires ExternalStorageBufferAttribute#dispose
+	 */
+	dispose() {
+
+		if ( this._bindingTokens.size > 0 ) {
+
+			throw new Error( 'THREE.ExternalStorageBufferAttribute: Dispose every material and compute node using this attribute before disposing it.' );
+
+		}
+
+		/**
+		 * Fires when the attribute has been disposed of.
+		 *
+		 * @event ExternalStorageBufferAttribute#dispose
+		 * @type {Object}
+		 */
+		this.dispatchEvent( { type: 'dispose' } );
+
+	}
+
+	/**
+	 * External storage attributes have no CPU data to upload.
+	 *
+	 * @type {boolean}
+	 * @default false
+	 * @param {boolean} value - The update flag.
+	 */
+	set needsUpdate( value ) {
+
+		if ( value === true ) {
+
+			throw new Error( 'THREE.ExternalStorageBufferAttribute: External GPU buffers cannot be updated from the CPU.' );
+
+		}
+
+	}
+
+}
+
+export default ExternalStorageBufferAttribute;
