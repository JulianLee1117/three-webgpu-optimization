index 0000000000000000000000000000000000000000..01b15dc76fb3aef8be09e2a8c7d5e6029b65b01f
--- /dev/null
+++ b/examples/webgpu_tsl_draw_index.html
@@ -0,0 +1,193 @@
+<!DOCTYPE html>
+<html lang="en">
+	<head>
+		<title>three.js webgpu - tsl - draw index</title>
+		<meta charset="utf-8">
+		<meta name="viewport" content="width=device-width, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0">
+		<meta property="og:title" content="three.js webgpu - tsl - draw index">
+		<meta property="og:type" content="website">
+		<meta property="og:url" content="https://threejs.org/examples/webgpu_tsl_draw_index.html">
+		<meta property="og:image" content="https://threejs.org/examples/screenshots/webgpu_tsl_draw_index.jpg">
+		<link type="text/css" rel="stylesheet" href="example.css">
+	</head>
+	<body>
+
+		<div id="info">
+			<a href="https://threejs.org/" target="_blank" rel="noopener" class="logo-link"></a>
+
+			<div class="title-wrapper">
+				<a href="https://threejs.org/" target="_blank" rel="noopener">three.js</a><span>TSL Draw Index</span>
+			</div>
+
+			<small id="description">
+				<code>drawIndex</code> ( top ) follows emitted command order; <code>batchIndirectIndex</code> ( bottom ) follows the original batch instance.<br>
+				<span id="order"></span>
+			</small>
+		</div>
+
+		<script type="importmap">
+			{
+				"imports": {
+					"three": "../build/three.webgpu.js",
+					"three/webgpu": "../build/three.webgpu.js",
+					"three/tsl": "../build/three.tsl.js",
+					"three/addons/": "./jsm/"
+				}
+			}
+		</script>
+
+		<script type="module">
+
+			import * as THREE from 'three/webgpu';
+			import { batchIndirectIndex, color, drawIndex, hue } from 'three/tsl';
+
+			const INSTANCE_COUNT = 8;
+			const PHASES = [ 3, 6, 1, 4, 7, 2, 5 ];
+			const STEP_DURATION = 1200;
+
+			let camera, renderer, scene;
+			let phase = PHASES[ 0 ];
+			let startTime;
+
+			const matrix = new THREE.Matrix4();
+			const position = new THREE.Vector3();
+			const quaternion = new THREE.Quaternion();
+			const rotation = new THREE.Euler();
+			const scale = new THREE.Vector3();
+
+			init();
+
+			async function init() {
+
+				renderer = new THREE.WebGPURenderer( { antialias: true } );
+				renderer.setPixelRatio( window.devicePixelRatio );
+				renderer.setSize( window.innerWidth, window.innerHeight );
+				renderer.toneMapping = THREE.ACESFilmicToneMapping;
+				renderer.toneMappingExposure = 1.2;
+				document.body.appendChild( renderer.domElement );
+
+				await renderer.init();
+
+				if ( renderer.backend.isWebGPUBackend !== true || renderer.backend.capabilities.hasImmediateData() === false ) {
+
+					document.getElementById( 'description' ).textContent = 'This example requires WebGPU immediate data support.';
+					return;
+
+				}
+
+				camera = new THREE.OrthographicCamera( - 1, 1, 1, - 1, 0.1, 100 );
+				camera.position.set( 0, 0, 10 );
+
+				scene = new THREE.Scene();
+				scene.background = new THREE.Color( 0x090c15 );
+
+				const hemisphereLight = new THREE.HemisphereLight( 0xa9c8ff, 0x182033, 2.5 );
+				scene.add( hemisphereLight );
+
+				const directionalLight = new THREE.DirectionalLight( 0xffffff, 3 );
+				directionalLight.position.set( 3, 5, 8 );
+				scene.add( directionalLight );
+
+				const geometry = new THREE.BoxGeometry( 0.9, 0.9, 0.9 );
+				scene.add(
+					createBatch( geometry, createMaterial( drawIndex ), 1.35 ),
+					createBatch( geometry, createMaterial( batchIndirectIndex ), - 1.35 )
+				);
+
+				onWindowResize();
+				window.addEventListener( 'resize', onWindowResize );
+				renderer.setAnimationLoop( animate );
+
+			}
+
+			function createMaterial( indexNode ) {
+
+				const material = new THREE.MeshStandardNodeMaterial( {
+					metalness: 0.1,
+					roughness: 0.35
+				} );
+				material.colorNode = hue(
+					color( 0xff3158 ),
+					indexNode.toFloat().mul( Math.PI * 2 / INSTANCE_COUNT )
+				);
+
+				return material;
+
+			}
+
+			function createBatch( geometry, material, y ) {
+
+				const mesh = new THREE.BatchedMesh(
+					INSTANCE_COUNT,
+					geometry.attributes.position.count,
+					geometry.index.count,
+					material
+				);
+				const geometryId = mesh.addGeometry( geometry );
+
+				for ( let i = 0; i < INSTANCE_COUNT; i ++ ) {
+
+					const instanceId = mesh.addInstance( geometryId );
+
+					position.set( ( i - ( INSTANCE_COUNT - 1 ) * 0.5 ) * 1.45, y, 0 );
+					rotation.set( 0.18 + i * 0.07, i * 0.31, ( i - 3.5 ) * 0.055 );
+					quaternion.setFromEuler( rotation );
+					scale.set( 0.82, 0.62 + i * 0.085, 0.82 );
+					matrix.compose( position, quaternion, scale );
+					mesh.setMatrixAt( instanceId, matrix );
+
+				}
+
+				mesh.frustumCulled = false;
+				mesh.perObjectFrustumCulled = false;
+				mesh.sortObjects = true;
+				mesh.setCustomSort( sortByPhase );
+
+				return mesh;
+
+			}
+
+			function sortByPhase( list ) {
+
+				const key = ( item ) => ( item.index - phase + INSTANCE_COUNT ) % INSTANCE_COUNT;
+				list.sort( ( a, b ) => key( a ) - key( b ) );
+
+			}
+
+			function updateOrder() {
+
+				const order = Array.from( { length: INSTANCE_COUNT }, ( _, i ) => ( phase + i ) % INSTANCE_COUNT );
+				document.getElementById( 'order' ).textContent = `command order: ${ order.join( ' → ' ) }`;
+
+			}
+
+			function onWindowResize() {
