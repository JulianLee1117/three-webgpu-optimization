{
  "name": "three-webgpu-optimization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproducible Three.js WebGPU optimization experiments",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulianLee1117/three-webgpu-optimization.git"
  },
  "bugs": {
    "url": "https://github.com/JulianLee1117/three-webgpu-optimization/issues"
  },
  "homepage": "https://github.com/JulianLee1117/three-webgpu-optimization#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:depth": "node scripts/smoke-depth-ordering.mjs",
    "smoke:frozen-depth": "node scripts/smoke-frozen-depth-crossover.mjs",
    "smoke:first-instance": "node scripts/smoke-first-instance-crossover.mjs",
    "smoke:first-instance-live": "node scripts/smoke-first-instance-live-crossover.mjs",
    "probe:first-instance": "node scripts/probe-first-instance-addressing.mjs",
    "benchmark:focused": "node scripts/run-benchmark.mjs",
    "candidate:init:first-instance-live": "node scripts/run-live-first-instance-candidate.mjs --initialize",
    "candidate:first-instance-live": "node scripts/run-live-first-instance-candidate.mjs",
    "verify:candidate:first-instance-live": "node analysis/verify-live-first-instance-candidate-pair.mjs",
    "sanitize:first-instance-live": "node scripts/sanitize-live-evidence.mjs",
    "build:public-pair:first-instance-live": "node scripts/build-public-live-first-instance-candidate-pair.mjs",
    "verify:public-pair:first-instance-live": "node analysis/verify-public-live-first-instance-candidate-pair.mjs",
    "build:public-package:first-instance-live": "node scripts/build-public-live-first-instance-package.mjs",
    "verify:public-package:first-instance-live": "node analysis/verify-public-live-first-instance-package.mjs",
    "analyze": "node analysis/summarize.mjs"
  },
  "dependencies": {
    "three": "0.185.1",
    "three-blocks-v10": "npm:three-blocks@0.10.0",
    "three-blocks-v11": "npm:three-blocks@0.11.0"
  },
  "devDependencies": {
    "playwright-core": "1.55.0",
    "vite": "7.2.2"
  }
}
